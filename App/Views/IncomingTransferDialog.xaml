<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="NearbyShare.App.Views.IncomingTransferDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NearbyShare.App.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/winfx/2006/xaml/presentation/design"
    mc:Ignorable="d"
    Title="Incoming files"
    PrimaryButtonText="Accept"
    CloseButtonText="Decline"
    DefaultButton="Close">

    <StackPanel Spacing="12" MaxWidth="380">
        <TextBlock Text="{x:Bind ViewModel.OfferSummary}" TextWrapping="Wrap" FontSize="14"/>

        <ListView ItemsSource="{x:Bind ViewModel.Files}" MaxHeight="220" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:IncomingFileRowViewModel">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="1" Text="{x:Bind SizeSummary}" Opacity="0.7"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </StackPanel>
</ContentDialog>
